# ─── Shopify ───────────────────────────────────────────────
# These are auto-populated by `shopify app dev` after you link the app.
# Leave blank; do not commit real values.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products

# ─── Sarvam (insight engine LLM) ───────────────────────────
# Get a key at https://dashboard.sarvam.ai  (key format: sk_...)
# Sent in the `api-subscription-key` header to https://api.sarvam.ai
SARVAM_API_KEY=
# Flagship chat model (largest available). 105B / 128K context.
SARVAM_MODEL=sarvam-105b
